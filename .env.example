# Real LLM provider. Mock mode is disabled.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=replace_with_your_key
# GEMINI_API_KEY=replace_with_your_key

# Optional providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2:3b

# Runtime LLM governance controls
LLM_MAX_CALLS_PER_RUN=6
LLM_MAX_ESTIMATED_COST_USD_PER_RUN=0.05
LLM_RESERVED_OUTPUT_TOKENS_PER_CALL=1024
LLM_INPUT_COST_PER_1K_TOKENS_USD=0.0003
LLM_OUTPUT_COST_PER_1K_TOKENS_USD=0.0025
LLM_KILL_SWITCH=false
# Optional file-based kill switch: create this file to stop external LLM calls.
LLM_KILL_SWITCH_FILE=runtime/llm_kill_switch.on
